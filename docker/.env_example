# -------- Server (mission_control) --------
WS_HOST=0.0.0.0
WS_PORT=8080
MAX_WS_MB=25
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=none
UPLOAD_DIR=/uploads

# Optional output dirs
CHATS_DIR=saved_chats
PROMPTS_DIR=prompts
TELEMETRY_DIR=telemetry
RECORDINGS_DIR=recordings
PULL_BATCH_SIZE=2
PULL_CHUNK_BYTES=524288

# Model selection. All backends use the prompt and move/found tools FlyLoRA was
# trained with (mission_control/ai/prompt_helpers/training_prompt.py).
#   openai - OpenAI cloud models via the Responses API (needs OPEN_AI_KEY)
#   vllm   - self-hosted FlyLoRA / base Qwen behind vLLM (needs VLLM_BASE_URL)
#   gemini - Google Gemini via function calling (needs GEMINI_AI_KEY)
MODEL_BACKEND=openai
MODEL_NAME=gpt-6-luna
# MODEL_BACKEND=gemini
# MODEL_NAME=gemini-3.8-flash
# MODEL_BACKEND=vllm
# MODEL_NAME=flylora               # or Qwen/Qwen3.5-9B for the base model

# API keys (set the one matching MODEL_BACKEND)
GEMINI_AI_KEY=YOUR_GEMINI_KEY
OPEN_AI_KEY=YOUR_OPENAI_KEY
# OPENAI_MAX_OUTPUT_TOKENS=

# Self-hosted vLLM (MODEL_BACKEND=vllm)
VLLM_BASE_URL=http://<vllm-host>:8000/v1
# VLLM_API_KEY=                    # only if vLLM was started with --api-key
# Cap on tokens per answer - bounds how long the thinking block can run in a live mission.
VLLM_MAX_TOKENS=3500
# Thinking is on by default, as in training. Set to true to answer directly.
VLLM_DISABLE_THINKING=false

# Prompt/grid-related
FOV_ANGLE=43
FONT_LOCATION=/fonts

# -------- Producer (drone_control) --------
SERVER_URL=ws://YOUR_SERVER_IP_OR_DOMAIN:8080
COMMANDS_DIR=/commands
VIDEO_DIR=/video
VIDEO_DEVICE=/dev/video0

WIDTH=480
HEIGHT=480
QUALITY=90
RECORD_FPS=30
ENABLE_VIDEO=0

MAV_DEVICE=/dev/ttyAMA0
MAV_BAUD=57600
TELEM_TIMEOUT=2.0
MOVE_METHOD=1
EXECUTE_MOVES=1
